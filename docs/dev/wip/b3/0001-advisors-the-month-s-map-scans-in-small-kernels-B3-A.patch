+  const i = z * st.size + x, zn = st.zone[i];
+  if (zn < Zone.ResLow || zn > Zone.IndHigh || st.building[i] >= 0 || st.network[i] !== Network.None || st.water[i] || st.powerLines[i]) return -1;
+  return lotFitAny(st, x, z, zn, minLotSide(zn));
