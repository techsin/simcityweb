+      if (rot === 0) { z0 = z - s + 1; x0 = x - k; }
+      else if (rot === 2) { z0 = z; x0 = x - k; }
+      else if (rot === 1) { x0 = x - s + 1; z0 = z - k; }
+      else { x0 = x; z0 = z - k; }
