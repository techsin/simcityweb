+        for (let zz = z0; zz < z0 + s && ok; zz++) if (!isRoadN(net[zz * N + fx])) ok = false;
+      }
+      if (!ok) continue;
+      if (lotSlope(st, x0, z0, s, s) > maxSlope) { steep = true; continue; }
+      return 0;
+    }
+  }
+  return steep ? 2 : 1;
