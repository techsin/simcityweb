+    const rng = new RNG(0x9e7);
+    const withQueries = runCycles(mk, 4, 0.05, (sim, k) => {
+      const tr = trafficOf(sim), st = sim.state, f = tr as unknown as { attachDirty: boolean };
+      tr.findPath(sim, rng.int(0, st.cells - 1), rng.int(0, st.cells - 1));
