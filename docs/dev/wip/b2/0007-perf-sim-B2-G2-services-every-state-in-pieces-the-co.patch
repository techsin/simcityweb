+// ------------------------------------------------------------------------------------------------ kernels
+describe('B2 G2 kernels: the resumable runs equal their whole-call originals', () => {
+  it('RoadTimeRun in random chunks (seed scan and drain) = roadTimeMulti, other searches between the chunks', () => {
